{
  "name": "wxt-module-safari-install",
  "version": "0.1.0",
  "description": "WXT module that builds, signs, and installs the generated Safari extension app locally (macOS). Pairs with wxt-module-safari-xcode.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib.js",
    "README.md"
  ],
  "keywords": [
    "wxt",
    "wxt-module",
    "safari",
    "safari-web-extension",
    "web-extension",
    "xcode",
    "xcodebuild",
    "macos",
    "dmg",
    "codesign"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mracos/wxt-module-safari-install.git"
  },
  "homepage": "https://github.com/mracos/wxt-module-safari-install#readme",
  "bugs": {
    "url": "https://github.com/mracos/wxt-module-safari-install/issues"
  },
  "author": "Marcos Ferreira (https://github.com/mracos)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "wxt": ">=0.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "wxt": "^0.21.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
